# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicit text file formats
*.py text eol=lf diff=python
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files
*.pt binary
*.pth binary
*.bin binary
*.safetensors binary
*.onnx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.tar.gz binary
*.zip binary
